# ContextFlow AI — copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key   # server-only

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium        # low | medium | high (gpt-oss only)

# RAG is Groq-only. Optional: enable pgvector search if your Groq account serves an embedding model
# (768-d, e.g. nomic-embed-text-v1_5). Leave empty for Groq full-text RAG (expansion + re-rank).
GROQ_EMBEDDING_MODEL=

# Telegram (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_BOT_USERNAME=                 # optional; fetched via getMe if empty
TELEGRAM_WEBHOOK_SECRET=random-long-string   # used with setWebhook secret_token (production)

# Cron endpoint auth (Vercel Cron sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=random-long-string

# Optional WhatsApp Cloud API (not implemented — provider interface ready)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug
DEMO_PASSWORD=NovaTech@2026
